{
  "name": "music-storage",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run sentry:sourcemaps",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "openapi": "npm run openapi:clear && npm run openapi:gen",
    "openapi:gen": "openapi-generator-cli generate",
    "openapi:clear": "rm -rf src/app/api",
    "e2e": "ng e2e",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org caterina-thimm --project javascript-angular ./dist && sentry-cli sourcemaps upload --org caterina-thimm --project javascript-angular ./dist"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.10",
    "@angular/cdk": "20.2.12",
    "@angular/common": "20.3.10",
    "@angular/compiler": "20.3.10",
    "@angular/core": "20.3.10",
    "@angular/forms": "20.3.10",
    "@angular/material": "20.2.12",
    "@angular/platform-browser": "20.3.10",
    "@angular/platform-browser-dynamic": "20.3.10",
    "@angular/router": "20.3.10",
    "@ngrx/effects": "^20.0.0",
    "@ngrx/store": "^20.0.0",
    "@openapitools/openapi-generator-cli": "^2.22.0",
    "@sentry/angular": "^10.23.0",
    "@sentry/cli": "^2.58.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "axios": "^1.11.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^20.0.0",
    "@angular/build": "^20.2.1",
    "@angular/cli": "20.3.9",
    "@angular/compiler-cli": "20.3.10",
    "@angular/language-service": "20.3.10",
    "@playwright/test": "1.55.0",
    "@testing-library/angular": "^18.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jasmine": "^5.1.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "jasmine-core": "^5.9.0",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "playwright-ng-schematics": "^2.1.0",
    "schematics-scss-migrate": "^2.3.17",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}